# Copy to `.env` and adjust. Every variable is optional; defaults are shown.
# The service reads `.env` at startup, and docker compose uses it for ${VAR} substitution.

# ─── HTTP server ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# WORKERS=8                       # HTTP worker threads (default: CPU cores)
# API_KEY=change-me               # require `X-API-Key` / `Authorization: Bearer` on /api/v1/*
CORS_ALLOWED_ORIGINS=*            # comma-separated origins, or *
MAX_UPLOAD_MB=512
JSON_LIMIT_MB=32
SWAGGER_UI_ENABLED=true           # /docs/ and /api-docs/openapi.json
METRICS_ENABLED=true              # Prometheus metrics at /metrics
SHUTDOWN_TIMEOUT_SECS=30

# ─── Storage ──────────────────────────────────────────────────────────────────
# Dataset snapshots, uploads and prediction logs. Use a shared volume when running replicas.
DATA_DIR=./data
PREDICTION_LOG_ENABLED=true

# ─── Vector store ─────────────────────────────────────────────────────────────
VECTOR_STORE=qdrant               # qdrant | memory (memory = dev/tests only)
QDRANT_URL=http://localhost:6334  # gRPC endpoint (legacy QDRANT_HOST/QDRANT_PORT/QDRANT_HTTPS also work)
# QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=recom    # collections: {prefix}_items, {prefix}_users
QDRANT_TIMEOUT_SECS=30
QDRANT_STARTUP_TIMEOUT_SECS=60    # wait this long for Qdrant at startup
QDRANT_ON_DISK_PAYLOAD=true
QDRANT_QUANTIZATION=none          # none | int8 (~4x less vector memory)
# QDRANT_SHARD_NUMBER=2           # for Qdrant clusters
# QDRANT_REPLICATION_FACTOR=2
# QDRANT_PAYLOAD_INDEXES=category:keyword,price:float,in_stock:bool   # speeds up filters

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=fastembed      # fastembed | openai | voyage | hash
EMBEDDING_MODEL=intfloat/multilingual-e5-small   # GET /api/v1/models lists fastembed models
# EMBEDDING_DIMENSION=            # auto-detected; also shortens OpenAI/Voyage vectors
EMBEDDING_BATCH_SIZE=32
# EMBEDDING_CACHE_DIR=./data/models               # fastembed model cache
EMBEDDING_POOL_SIZE=1             # fastembed model instances (concurrency vs memory)
# EMBEDDING_THREADS=4             # ONNX threads per instance (default: all cores)
# EMBEDDING_MAX_LENGTH=512        # max tokens per text
# EMBEDDING_QUERY_PREFIX=         # override the model's query prefix (e.g. "query: ")
# EMBEDDING_DOCUMENT_PREFIX=      # override the model's document prefix (e.g. "passage: ")
# Remote providers:
# EMBEDDING_API_BASE=https://api.openai.com/v1    # or http://localhost:11434/v1 (Ollama), TEI, vLLM...
# EMBEDDING_API_KEY=              # falls back to OPENAI_API_KEY / VOYAGE_API_KEY
EMBEDDING_TIMEOUT_SECS=60
EMBEDDING_MAX_RETRIES=3

# ─── Training & recommendations ───────────────────────────────────────────────
TRAINING_BATCH_SIZE=256           # rows embedded + upserted per batch
TRAINING_MAX_CONCURRENT_JOBS=2
TRAINING_STALE_AFTER_SECS=600     # a job without progress for this long counts as interrupted
USER_PROFILE_MAX_ITEMS=500        # recent items remembered per user (excluded from results)
RECOMMEND_DEFAULT_LIMIT=10
RECOMMEND_MAX_LIMIT=200
RECOMMEND_MAX_OFFSET=10000

# ─── Logging ──────────────────────────────────────────────────────────────────
RUST_LOG=info
LOG_FORMAT=pretty                 # pretty | json
